#!/bin/bash
# Uploads the iOS app at the current commit to TestFlight, from the dev box, over SSH on the build Mac.
# The hosts and the team ID come from ~/.config/clotho/local.env (private); CLOTHO_MAC overrides the host.
#
# Usage: scripts/testflight-remote [--dry-run | --no-upload]
#
# 1. Hashes the app's sources at HEAD (from git, so stray files don't count) with ios/scripts/sources-sha.sh.
# 2. Syncs the working tree to the iOS mirror on the build Mac (scripts/clotho-build ios).
# 3. Runs ios/scripts/testflight.sh there with EXPECT_SOURCES_SHA, so the Mac refuses to build anything but HEAD.
#
# The App Store Connect key ids come from ~/.config/clotho/asc.env (mode 600, never in the repo); the key itself
# and the keychain password stay on the Mac. Coordinate with the ios agent: this uses its mirror (~/Builds/clotho-ios).
set -euo pipefail
local_env=${CLOTHO_LOCAL_ENV:-$HOME/.config/clotho/local.env}
# shellcheck disable=SC1090
[ -r "$local_env" ] && . "$local_env"
export CLOTHO_MAC=${CLOTHO_MAC:-${CLOTHO_BUILD_HOST:?set CLOTHO_BUILD_HOST in $local_env}}
: "${CLOTHO_TEAM_ID:?set CLOTHO_TEAM_ID in $local_env}" "${CLOTHO_RELAY_URL:?set CLOTHO_RELAY_URL in $local_env}"
cd "$(dirname "$0")/.."

case "${1:-}" in "" | --dry-run | --no-upload) ;; *) echo "usage: scripts/testflight-remote [--dry-run | --no-upload]" >&2; exit 64 ;; esac

env_file=$HOME/.config/clotho/asc.env
[ -r "$env_file" ] || { echo "testflight-remote: missing $env_file" >&2; exit 2; }
# shellcheck disable=SC1090
. "$env_file"
: "${ASC_KEY_ID:?not set in $env_file}" "${ASC_ISSUER_ID:?not set in $env_file}"

paths=(ios ClothoKit clothod/RELEASED)
if ! git diff --quiet HEAD -- "${paths[@]}" || [ -n "$(git ls-files --others --exclude-standard -- "${paths[@]}")" ]; then
  echo "testflight-remote: the working tree differs from HEAD in the app's sources; commit or stash first" >&2
  exit 2
fi

tmp=$(mktemp -d)
trap 'rm -rf "$tmp"' EXIT
git archive HEAD "${paths[@]}" | tar -x -C "$tmp"
sha=$(ios/scripts/sources-sha.sh "$tmp")
echo "==> $(git log --oneline -1 HEAD) | sources $sha | clothod $(cat clothod/RELEASED)"

scripts/clotho-build ios true
# Keep only the newest archive in ~/Builds/testflight on the build Mac.
ssh "$CLOTHO_MAC" "cd ~/Builds/clotho-ios && ASC_KEY_ID=$(printf %q "$ASC_KEY_ID") ASC_ISSUER_ID=$(printf %q "$ASC_ISSUER_ID") CLOTHO_TEAM_ID=$(printf %q "$CLOTHO_TEAM_ID") CLOTHO_RELAY_URL=$(printf %q "$CLOTHO_RELAY_URL") EXPECT_SOURCES_SHA=$sha zsh -lc $(printf %q "ios/scripts/testflight.sh ${1:-}")"
ssh "$CLOTHO_MAC" 'cd ~/Builds/testflight 2>/dev/null && ls -dt Clotho-* | tail -n +2 | xargs rm -rf; rm -rf ~/Builds/clotho-ios/ios/build/Index.noindex; df -h /System/Volumes/Data | tail -1'
