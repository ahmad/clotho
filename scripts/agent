#!/bin/sh
# Starts one of the three Clotho role agents as a named Claude Code session at the repo root.
# Usage: scripts/agent clothod|mac|ios [extra claude args...]
# Run each in its own pane. The name is what peers see in ListAgents and send to with SendMessage.
# The role's instructions are in .claude/agents/<role>.md; the shared rules are in CLAUDE.md.
set -e
role=${1:-}
case $role in
  clothod|mac|ios) shift ;;
  *) echo "usage: scripts/agent clothod|mac|ios [claude args...]" >&2; exit 2 ;;
esac
cd "$(dirname "$0")/.."
exec claude --agent "$role" -n "$role" "$@"
