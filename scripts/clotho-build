#!/bin/bash
# Runs a command on the build Mac (imac) in a mirror of this clone that belongs to one agent, so two
# agents' syncs and builds never delete each other's files. Like clotho-mac, but one mirror per role.
#
# Usage: scripts/clotho-build <clothod|mac|ios|main> <command...>
#   e.g. scripts/clotho-build ios ios/build.sh test
#        scripts/clotho-build mac 'cd mac && swift test --disable-keychain'
#
# Mirrors on the build Mac:
#   clothod       ~/Builds/clotho-clothod   (the canonical one: clothod/dist, the released builds, lives here)
#   mac           ~/Builds/clotho-mac
#   ios           ~/Builds/clotho-ios
#   main          ~/Builds/clotho-orch   (the main session's mirror)
# In every mirror but clothod's, clothod/dist is a symlink to the canonical dist, so app builds bundle the
# released clothod. The sync never touches clothod/dist (excluded), build outputs, or generated projects.
# CLOTHO_MAC picks another host (default macbook@imac).
set -euo pipefail
role=${1:-}
case $role in
  clothod) dest=Builds/clotho-clothod ;;
  mac) dest=Builds/clotho-mac ;;
  ios) dest=Builds/clotho-ios ;;
  main) dest=Builds/clotho-orch ;;
  *) echo "usage: scripts/clotho-build <clothod|mac|ios|main> <command...>" >&2; exit 64 ;;
esac
shift
host=${CLOTHO_MAC:-macbook@imac}
canon=Builds/clotho-clothod

ssh "$host" "set -e; mkdir -p $dest/ios/build-resources/dist $dest/clothod
  if [ $dest != $canon ] && [ ! -e $dest/clothod/dist ]; then ln -s ~/$canon/clothod/dist $dest/clothod/dist; fi"
rsync -a --delete \
  --exclude .git/ --exclude target/ --exclude build/ --exclude .build/ --exclude node_modules/ \
  --exclude .wrangler/ --exclude /clothod/dist --exclude ios/build-resources/ \
  --exclude '*.xcodeproj/' --exclude DerivedData/ \
  "$(cd "$(dirname "$0")/.." && pwd)/" "$host:$dest/"
[ $# -eq 0 ] && exit 0
tty=; [ -t 0 ] && tty=-t
exec ssh $tty "$host" "cd $dest && exec zsh -lc $(printf %q "$*")"
